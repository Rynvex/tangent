 {
  "uuid": "f14-tx-limits",
  "name": "PgBouncer transaction mode 的限制",
  "created_at": "2026-08-12T07:10:00Z",
  "updated_at": "2026-08-12T07:22:00Z",
  "chat_messages": [
   {
    "uuid": "f14-tx-limits-1",
    "sender": "human",
    "text": "PgBouncer transaction mode 下哪些功能不能用？",
    "created_at": "2026-08-12T07:10:00Z"
   },
   {
    "uuid": "f14-tx-limits-2",
    "sender": "assistant",
    "text": "session 層級的狀態都不能依賴：SET、advisory lock、LISTEN／NOTIFY。",
    "created_at": "2026-08-12T07:12:00Z"
   },
   {
    "uuid": "f14-tx-limits-3",
    "sender": "human",
    "text": "那時區之類的設定怎麼辦？",
    "created_at": "2026-08-12T07:20:00Z"
   },
   {
    "uuid": "f14-tx-limits-4",
    "sender": "assistant",
    "text": "不能用 session 層級的 SET；改在交易內用 SET LOCAL。其他設定放在連線字串。",
    "created_at": "2026-08-12T07:22:00Z"
   }
  ]
 },
