     },
     "recipient": "all",
     "content": {
      "content_type": "text",
      "parts": [
       "共用表。MVCC 會不會影響讀取？"
      ]
     },
     "metadata": {}
    }
   },
   "m4old": {
    "id": "m4old",
    "parent": "m3old",
    "children": [],
    "message": {
     "id": "m4old",
     "author": {
      "role": "assistant"
     },
     "recipient": "all",
     "content": {
      "content_type": "text",
      "parts": [
