{
  "name": "@tangent/react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React provider, i18n, query keys, design tokens, base components, layout frame and shortcuts for Tangent.",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
