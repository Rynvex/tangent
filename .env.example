# tangent-server reads only environment variables. Copy to .env, fill in, and
# load it yourself (for example: set -a; . ./.env; set +a). Never commit real keys.
#
# Quick pick: leave exactly one scenario below switched on, then `make serve`.
#
# --- Scenario A: try it, no key and no login (the default in this file) -------
# Fake replies, listens on 127.0.0.1 only, no token. If `claude`, `codex` or
# `agy` is installed it is detected too (see TANGENT_CLI_AUTODETECT).
TANGENT_DEV=1
#
# --- Scenario B: Claude Code subscription (run `claude login` once) -----------
# Switch off TANGENT_DEV above, then:
# TANGENT_TOKEN=            # openssl rand -hex 32
# TANGENT_PROVIDER=claude-cli
# TANGENT_CLAUDE_CLI_MODEL=sonnet
#
# --- Scenario C: Claude CLI and Codex CLI side by side (`codex login` too) ---
# TANGENT_TOKEN=            # openssl rand -hex 32
# TANGENT_PROVIDER=claude-cli
# TANGENT_CLAUDE_CLI_MODEL=sonnet
# TANGENT_CODEX_CLI_MODEL=gpt-6-luna
# Both then appear in the web model picker. Optional safety net: when a
# subscription hits its usage limit before any text streamed, the turn runs
# once more on this model (provider:model, validated like TANGENT_JOB_MODEL):
# TANGENT_FALLBACK_MODEL=codex-cli:gpt-6-luna
#
# --- Scenario D: OpenAI-compatible or Anthropic API ---------------------------
# TANGENT_TOKEN=            # openssl rand -hex 32
# TANGENT_PROVIDER=openai
# TANGENT_MODEL=<model name>
# OPENAI_API_KEY=<your key>
# or:
# TANGENT_PROVIDER=anthropic
# TANGENT_MODEL=<model name>
# ANTHROPIC_API_KEY=<your key>
#
# Scenarios B to D listen on :8120 (every interface) behind the token. The web
# dev server adds the token for you: TANGENT_API_TOKEN=<the same token>
# VITE_TANGENT_API=http pnpm -C web dev. To stay on this machine set
# TANGENT_ADDR=127.0.0.1:8120.

# Database (default: the docker compose database on :5444).
TANGENT_DATABASE_URL=postgres://tangent:tangent@localhost:5444/tangent?sslmode=disable

# Where to listen (default :8120; 127.0.0.1:8120 in dev mode without a token).
# TANGENT_ADDR=:8120

# Clients send Authorization: Bearer <token>. Required (32+ characters) unless
# TANGENT_DEV=1 and the address is a loopback one (then only localhost Host
# headers are answered). Make one with: openssl rand -hex 32
# TANGENT_TOKEN=
# A second token that can only read (403 forbidden on every write):
# TANGENT_VIEWER_TOKEN=

# Who every request acts as (the reference server has a single tenant).
# TANGENT_TENANT=default
# TANGENT_ACTOR=operator

# Default model provider: fake | openai | anthropic | claude-cli | codex-cli |
# agy-cli. Required, except that TANGENT_DEV=1 defaults it to fake.
# TANGENT_PROVIDER=fake
# Model used when a conversation names none (required for every provider but fake).
# TANGENT_MODEL=

# OpenAI-compatible endpoints (OpenAI, DeepSeek, OpenRouter, Ollama ...).
# OPENAI_API_KEY=
# TANGENT_OPENAI_BASE_URL=https://api.openai.com/v1
# TANGENT_OPENAI_MODEL=

# Anthropic.
# ANTHROPIC_API_KEY=
# TANGENT_ANTHROPIC_BASE_URL=https://api.anthropic.com
# TANGENT_ANTHROPIC_MODEL=

# Command-line AI tools logged in with a subscription on this machine (one
# process per turn, chat only: no tools, an empty temporary directory, prompt
# on stdin). Personal use only; background jobs are better on an API model
# (TANGENT_JOB_MODEL). A provider is on when it is TANGENT_PROVIDER, has a
# model here, or is TANGENT_JOB_MODEL's. PATH defaults to the command's name.
# TANGENT_CLAUDE_CLI_PATH=claude
# TANGENT_CLAUDE_CLI_MODEL=sonnet
# TANGENT_CLAUDE_CLI_MAX_CONCURRENT=2
# TANGENT_CODEX_CLI_PATH=codex
# TANGENT_CODEX_CLI_MODEL=gpt-5-codex
# TANGENT_CODEX_CLI_MAX_CONCURRENT=2
# Antigravity CLI (agy; `agy models` lists the model slugs). agy keeps every
# run as a conversation in its own history (~/.gemini/antigravity-cli).
# TANGENT_AGY_CLI_PATH=agy
# TANGENT_AGY_CLI_MODEL=gemini-3.8-flash-medium
# TANGENT_AGY_CLI_MAX_CONCURRENT=2
# The CLIs see only PATH, HOME, the locale, proxy / CA settings and their own
# config variables (CLAUDE_CONFIG_DIR, CODEX_HOME, AGY_ADC_AUTH, GOOGLE_CLOUD_PROJECT); name
# more here, comma separated (TANGENT_*, *DATABASE_URL* and *API_KEY are refused):
# TANGENT_CLI_ENV=CLAUDE_CODE_OAUTH_TOKEN
# Detect the CLIs at startup: every one whose executable is found is switched
# on with its built-in model list (below). 1/true/on/yes or 0/false/off/no;
# unset: on with TANGENT_DEV=1, off otherwise. A missing CLI never stops the
# server: it is logged as skipped and GET /api/capabilities reports it not ready.
# TANGENT_CLI_AUTODETECT=1

# Model for background jobs (summary, card draft), as provider:model (for
# example the main line on claude-cli, jobs on a cheap API model):
# TANGENT_JOB_MODEL=anthropic:claude-haiku-4-5
# Model for a turn that hit a usage or rate limit before any text streamed: it
# runs once more on this one (provider:model). Unset: no retry.
# TANGENT_FALLBACK_MODEL=anthropic:claude-haiku-4-5
# Models conversations may choose, as provider:model, comma separated.
# Unset: the configured models (TANGENT_MODEL, TANGENT_*_MODEL,
# TANGENT_JOB_MODEL, TANGENT_FALLBACK_MODEL) plus the built-in list of every
# running CLI provider (claude-cli: claude-opus-5-5, claude-sonnet-5-5,
# claude-haiku-5-5, claude-fable-5-2 and the aliases opus, sonnet, haiku,
# fable; codex-cli: gpt-6.1-sol, gpt-6-astra, gpt-6-luna, gpt-5.4-mini;
# agy-cli: gemini-4-carbon, gemini-4-argon and the gemini-3.8-flash family).
# Set: exactly this list, nothing else (no built-in list, no aliases), which
# is how to lock the server to a few models. To override a built-in name,
# list the model you want here.
# GET /api/capabilities lists the models of providers with a runner.
# TANGENT_ALLOWED_MODELS=claude-cli:claude-sonnet-5-5,anthropic:claude-haiku-4-5

# Features: name or name:mode, comma separated, or a preset (B25):
#   essential  notes, chapters, aside, summary:suggest, card_draft, leaf:manual,
#              parking, spinoff, search, memo, glossary (the main loop only)
#   standard   every first-batch feature plus search and the P1-P3 features
#              (the default when TANGENT_FEATURES is unset)
#   full       standard plus fisheye and memory (memory needs TANGENT_EMBEDDER;
#              the fake provider uses the fake embedder, logged as a WARN)
# Presets and features mix, read left to right: a later entry for a feature
# replaces the earlier one, "none" clears everything before it.
# Modes (summary, branch_suggest, leaf, goal, ...): off, manual, suggest, auto.
# search needs the pg_trgm extension: the server runs CREATE EXTENSION pg_trgm
# at startup (leave search out on a database without it).
# TANGENT_FEATURES=essential,goal:manual,relations:manual

# Model prices in USD per million tokens (enables cost totals and preview estimates).
# TANGENT_PRICING={"claude-sonnet-4-5":{"input":3,"output":15,"cacheRead":0.3,"cacheWrite":3.75}}

# Limits and loops.
# TANGENT_RATE_LIMIT=600            # API requests per minute, per address and per token
# TANGENT_RATE_BURST=60             # (failed authentications: 5, then 10 a minute per address)
# TANGENT_MAINTAIN_INTERVAL=1m      # stale turns / jobs, expired asides
# TANGENT_TURN_TIMEOUT=10m
# TANGENT_MAX_CONCURRENT=8          # model runs at once
# TANGENT_MAX_QUEUE=64              # turns and jobs held at once (running or waiting)
# TANGENT_MAX_TENANT_TURNS=16       # turns of one tenant held at once
# TANGENT_MAX_STREAMS=64            # open /events streams
# TANGENT_SHUTDOWN_TIMEOUT=30s
# TANGENT_FAKE_CHUNK_DELAY=30ms     # pace of the fake runner's stream
# TANGENT_LOG_LEVEL=info
# TANGENT_DEBUG_STATS=1             # GET /debug/stats (token): goroutines, memory, pool (soak runs)

# Serve the built demo UI (pnpm -C web build) from this directory.
# TANGENT_STATIC_DIR=web/apps/demo/dist

# Real-model smoke test (go test ./cmd/tangent-server -run TestRealModelSmoke):
# TANGENT_REAL_SMOKE=1 with TANGENT_PROVIDER, TANGENT_MODEL and the provider's key.
# One real CLI call (go test ./runner/cli -run TestRealCLISmoke -v; uses the
# subscription's quota): TANGENT_CLI_SMOKE=claude|codex|agy, optional
# TANGENT_CLI_SMOKE_MODEL and TANGENT_CLI_SMOKE_PATH.
